{
  "name": "sistema-gestion-gimnasio",
  "version": "1.0.0",
  "description": "Plataforma de gestión de gimnasio y reservas de clases para F6 Deporte y Recreación",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"tsx watch server/index.ts\" \"vite --host\"",
    "server": "tsx watch server/index.ts",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "git:setup": "node scripts/git-setup.js",
    "git:push": "node scripts/git-push.js"
  },
  "keywords": [
    "gym",
    "management",
    "react",
    "express",
    "sqlite"
  ],
  "author": "F6 Deporte y Recreación",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ignore": "^7.0.6",
    "isomorphic-git": "^1.41.7",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
